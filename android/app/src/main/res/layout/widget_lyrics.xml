<?xml version="1.0" encoding="utf-8"?>
<!--
  Song-Info oben (fix, kein Zeilenumbruch), darunter ein Fenster aus Zeilen
  rund um die aktive Lyric-Zeile (LyricsWidgetProvider baut die Kind-Views
  direkt per addView() zusammen, keine ListView/RemoteViewsService mehr -
  setScrollPosition() wurde auf manchen Launchern (u.a. dem hier getesteten
  Samsung One UI) trotz korrektem Aufruf nachweislich nicht zuverlässig
  umgesetzt. Mit fest zusammengebauten Zeilen steht die aktive Zeile
  garantiert exakt in der Mitte, ganz ohne Scroll-API).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_track"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text_dim"
        android:textSize="12sp"
        android:text="Lyrics Display" />

    <LinearLayout
        android:id="@+id/widget_lines"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:gravity="center_vertical" />

</LinearLayout>
