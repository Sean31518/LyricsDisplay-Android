<?xml version="1.0" encoding="utf-8"?>
<!-- App-Icon Vordergrund: Doppel-Achtelnote (Spotify-Grün) über dem
     "Lyrics-Blatt" aus ic_launcher_background.xml. Der grüne Balken direkt
     unter den Notenköpfen überschreibt exakt das Segment der weißen
     Hintergrund-Zeile (y=80), auf der die Note optisch aufsitzt - simuliert
     so eine hervorgehobene/aktive Lyric-Zeile, wie im Player selbst. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportHeight="108"
    android:viewportWidth="108">
    <!-- Hervorgehobenes Zeilen-Segment unter der Note -->
    <path
        android:fillColor="#00000000"
        android:pathData="M32,80L86,80"
        android:strokeColor="#1DB954"
        android:strokeLineCap="round"
        android:strokeWidth="6" />
    <!-- Balken -->
    <path
        android:fillColor="#1DB954"
        android:pathData="M45,25L75,25L75,32L45,32Z" />
    <!-- Hälse -->
    <path
        android:fillColor="#1DB954"
        android:pathData="M45.5,28L48.5,28L48.5,66L45.5,66Z" />
    <path
        android:fillColor="#1DB954"
        android:pathData="M71.5,28L74.5,28L74.5,66L71.5,66Z" />
    <!-- Notenköpfe -->
    <group
        android:pivotX="41"
        android:pivotY="66"
        android:rotation="-25">
        <path
            android:fillColor="#1DB954"
            android:pathData="M32,66A9,5.5 0,1,0 50,66A9,5.5 0,1,0 32,66Z" />
    </group>
    <group
        android:pivotX="67"
        android:pivotY="66"
        android:rotation="-25">
        <path
            android:fillColor="#1DB954"
            android:pathData="M58,66A9,5.5 0,1,0 76,66A9,5.5 0,1,0 58,66Z" />
    </group>
</vector>
